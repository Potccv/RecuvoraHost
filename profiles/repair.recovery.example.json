{
  "schema_version": 3,
  "data_dir": "runtime/recovery",
  "ownership_dir": "runtime/target-ownership",
  "approval_store": {
    "max_requests": 10000,
    "max_journal_bytes": 33554432
  },
  "knowledge_store": {
    "max_records": 1024,
    "max_journal_bytes": 67108864
  },
  "recovery": {
    "schema_version": 2,
    "execution_harness": "harness-external",
    "target": {
      "target_id": "target",
      "executor_id": "target-node",
      "verification_profile": "workload-health-v1",
      "required_facts": {
        "workload_version": "1"
      },
      "action_timeout_secs": 60,
      "allowed_action_kinds": [
        "execute_script"
      ]
    },
    "approval": {
      "id": "repair-policy",
      "version": 1,
      "reviewer": {
        "mode": "human_then_harness",
        "harness_id": "harness-external",
        "human_wait_secs": 600,
        "review_timeout_secs": 120
      },
      "delegation": "Authorize a bounded Harness repair session for the configured target, with read-only inspection and at most one scoped external repair action; require independent business verification.",
      "allowed_targets": [
        "target"
      ],
      "allowed_action_kinds": [
        "repair_with_harness"
      ],
      "ttl_secs": 1800
    },
    "review_timeout_secs": 120,
    "max_tool_calls": 16,
    "max_tasks": 1024,
    "summary_timeout_secs": 120
  },
  "interval_ms": 1000,
  "executor": {
    "platform": "windows",
    "allowed_languages": [
      "powershell"
    ],
    "diagnostic_queries": [
      "snapshot",
      "recent-observations"
    ]
  }
}
